FROM python:3.12-slim AS build

WORKDIR /build
COPY pyproject.toml README.md ./
COPY packages ./packages
RUN pip wheel --no-cache-dir --wheel-dir /wheels ".[runpod]"

FROM python:3.12-slim

RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system openmaster && useradd --system --gid openmaster --create-home openmaster

WORKDIR /app
COPY --from=build /wheels /wheels
RUN python -m pip install --no-cache-dir /wheels/*.whl && rm -rf /wheels
COPY apps/runpod_worker ./apps/runpod_worker
COPY apps/__init__.py ./apps/__init__.py

USER openmaster
CMD ["python", "-m", "apps.runpod_worker.handler"]
